<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme. Compose controls most colors; keep XML theme minimal. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Android 12+ splash screen -->
    <style name="Theme.Pulse.Splash" parent="Theme.SplashScreen">
        <!-- Telegram iOS-ish blue -->
        <item name="windowSplashScreenBackground">#2AABEE</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>